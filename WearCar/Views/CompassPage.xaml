<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             x:Class="WearCar.Views.CompassPage"
             Title="Find Car">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12">
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="12">
            <Label Text="Distance:" VerticalOptions="Center" FontSize="18" />
            <Label Text="{Binding DistanceText}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
        </StackLayout>

        <Grid x:Name="CompassArea" Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" SizeChanged="CompassArea_SizeChanged">
            <ContentView x:Name="ArrowContainer" HorizontalOptions="Center" VerticalOptions="Center">
                <Image x:Name="HeadImage" Source="compass_arrow_pointer.svg" Aspect="Fill" WidthRequest="180" HeightRequest="200" />
            </ContentView>
        </Grid>

        <StackLayout Grid.Row="2" Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="End" Spacing="4" Margin="0,8,0,0">
            <Label Text="Pointing to parked car" HorizontalOptions="Center" />
            <Label x:Name="SpeedLabel" Text="{Binding CurrentSpeedText}" HorizontalOptions="Center" FontSize="12" TextColor="Gray" />
        </StackLayout>

        <!-- Test Banner Ad Unit ID: ca-app-pub-3940256099942544/6300978111 -->
        <controls:BannerAd Grid.Row="3"
                           AdUnitId="ca-app-pub-4574428511610255/1704577836"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0" />
    </Grid>
</ContentPage>
